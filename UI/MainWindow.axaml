<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LeitorPrecos.MainWindow"
        Title="LeitorPrecos">
    
        <StackPanel>
            <Grid x:Name="Container" RowDefinitions="Auto, *" Margin="15,20,0,15">
                <TextBox x:Name="InputBox" PlaceholderText="Digite o caminho do arquivo aqui" Width="450"></TextBox>
                
                <Button Click="GettingFileRead">
                    Carregar Dados
                </Button>
            </Grid>

            <StackPanel x:Name="DataContainer" HorizontalAlignment="Center">
                <ListBox x:Name="ListContent">

                </ListBox>
            </StackPanel>
        </StackPanel>
</Window>
